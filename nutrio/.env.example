# Copie para .env.local e preencha.
# Supabase local: rode `npm run db:start` e use os valores impressos (API URL e Publishable/anon key).
# Supabase na nuvem: Project Settings → API.
# Só a chave PÚBLICA vai no frontend. Nunca coloque a service_role aqui.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
